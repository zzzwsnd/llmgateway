GATEWAY_PORT=8000
POSTGRES_DB=llmgateway
POSTGRES_USER=llmgateway
POSTGRES_PASSWORD=replace-with-local-postgres-password
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_DATABASE=0
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Keep these defaults for local builds. For GHCR, select an immutable image
# tag and change the pull policy to always.
GATEWAY_IMAGE=llmgateway:local
GATEWAY_PULL_POLICY=build
